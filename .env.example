DATABASE_URL=sqlite+aiosqlite:///./weather.db
PORT=8001

# Tide data source: fixture | admiralty_discovery
TIDE_DATA_SOURCE=admiralty_discovery

# Admiralty UK Tidal API — Discovery tier (free, 7-day horizon)
# 1. Sign up: https://developer.admiralty.co.uk/product#product=uk-tidal-api
# 2. Subscribe to "UK Tidal API - Discovery"
# 3. Profile → show Primary key → paste below (never commit .env)
ADMIRALTY_API_KEY=

# Discovery allows duration 1–7 (today plus up to 6 future days)
TIDE_FORECAST_DAYS=7

# Optional: comma-separated location IDs to ingest (empty = all seeded locations)
# TIDE_LOCATION_IDS=mine-uk-003,blue-uk-010,teig-uk-009

# Current weather for GET /api/weather/{location_id}
# fixture = deterministic local data (default, no key needed)
# openweather = live OpenWeatherMap current conditions
WEATHER_DATA_SOURCE=fixture
OPENWEATHER_API_KEY=
